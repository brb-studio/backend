# Copy to .env (git-ignored). Never commit real values.

# Local MongoDB (Homebrew mongodb-community@8.0, single-node replica set rs0: transactions need a replica set).
# Outside NODE_ENV=production the app refuses any host other than localhost / 127.0.0.1 / [::1].
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Only this database is used. Other databases on the same server are never touched.
MONGO_DB=brb-studio
PORT=4000
# Tenants live at <slug>.<PLATFORM_DOMAIN> (dev: magicstudio.localhost); other hosts are matched as custom domains.
PLATFORM_DOMAIN=localhost
# Shared secret with the frontend's server (the same PROXY_SECRET there). Only requests carrying it may
# pass the visitor's IP in X-Forwarded-For; everyone else is rate-limited by socket address.
# Required in production. Generate: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
PROXY_SECRET=
# NODE_ENV=production in deploys (enables the production checks; MONGO_URL then needs auth + TLS).
# Web Push to staff phones: `bun run vapid:keys` prints a pair. Set all three or none (push stays off).
# VAPID_SUBJECT must be a mailto: or https: URL push services can reach you at.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Pagos de citas en línea (tarjeta y transferencia) con Stripe Connect: la plataforma cobra y Stripe deposita a la
# cuenta conectada de cada barbería. Sin estas dos variables los pagos en línea quedan apagados y se usa la
# transferencia manual. Fuera de producción solo se aceptan llaves de test (sk_test_/rk_test_); en producción, live.
# Prefiere una llave restringida (rk_). STRIPE_WEBHOOK_SECRET: los whsec_ de cada destino de webhook, separados por
# coma (en local, el que imprime `stripe listen`). El endpoint es POST /webhooks/stripe.
# CRON_SECRET: permite que un cron (Vercel Cron o cualquier pinger) llame GET /cron/digest con "Authorization: Bearer <secreto>"
# para el resumen diario por push. En serverless no hay temporizador del servidor; sin esto esa ruta responde 404. 32+ caracteres.
# CRON_SECRET=
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Comisión que la plataforma retiene para cubrir la de Stripe (la absorbe la barbería), en puntos base + fijo, más IVA:
# STRIPE_CARD_FEE_BPS=360
# STRIPE_CARD_FEE_FIXED_MINOR=300
# Shops charging in USD: fixed part in cents, plus foreign-card and conversion surcharges (bps).
# STRIPE_CARD_FEE_FIXED_MINOR_USD=20
# STRIPE_INTL_CARD_FEE_BPS=50
# STRIPE_FX_FEE_BPS=200
# STRIPE_TRANSFER_FEE_BPS=0
# STRIPE_TRANSFER_FEE_FIXED_MINOR=700
# STRIPE_FEE_TAX_BPS=1600
# Minutos que se aparta el horario mientras el cliente paga:
# PAYMENT_HOLD_CARD_MIN=20
# PAYMENT_HOLD_TRANSFER_MIN=60
# Respaldo: transferencias SPEI directo a la CLABE de cada barbería (se configura en el panel, no aquí).
# Firma el comprobante de reserva con el que un invitado pide los datos bancarios. Obligatorio en producción
# (mínimo 32 caracteres); en desarrollo hay un valor por defecto.
# PAYMENT_TOKEN_SECRET=
# URL pública del frontend (CORS).
# FRONTEND_URL=http://localhost:3000
# Suscripción de las barberías a la app: un solo precio mensual, pagado por transferencia SPEI a la CLABE del
# documento activo de la colección `ownerProject` (se edita a mano; `name` es el titular). Plataforma confirma
# cada pago en /platform. Precio en unidades menores (30000 = 300.00).
# SUBSCRIPTION_PRICE_MINOR=30000
# SUBSCRIPTION_CURRENCY=MXN
# CORS: el frontend llama desde su servidor, así que normalmente no hace falta. Se permiten FRONTEND_URL y
# cualquier https://<slug>.PLATFORM_DOMAIN. Dominios propios de barberías: agrégalos aquí, separados por coma.
# CORS_ORIGINS=https://mibarberia.mx,https://otra.com
# Correo transaccional (verificación de correo y restablecer contraseña) con Resend. Pon las dos o ninguna.
# Sin ellas, fuera de producción el correo se imprime en la consola del backend; en producción no se envía.
# MAIL_FROM debe ser una dirección de un dominio verificado en Resend, p. ej. "brb-studio <no-reply@tudominio.com>".
# RESEND_API_KEY=re_...
# MAIL_FROM=
