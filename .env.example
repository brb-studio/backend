# Copy to .env (git-ignored). Never commit real values.

# Local MongoDB (Homebrew mongodb-community@8.0, single-node replica set rs0: transactions need a replica set).
# Outside NODE_ENV=production the app refuses any host other than localhost / 127.0.0.1 / [::1].
MONGO_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
# Only this database is used. Other databases on the same server are never touched.
MONGO_DB=magicstudio
PORT=4000
# Tenants live at <slug>.<PLATFORM_DOMAIN> (dev: magicstudio.localhost); other hosts are matched as custom domains.
PLATFORM_DOMAIN=localhost
# Shared secret with the frontend's server (the same PROXY_SECRET there). Only requests carrying it may
# pass the visitor's IP in X-Forwarded-For; everyone else is rate-limited by socket address.
# Required in production. Generate: bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
PROXY_SECRET=
# NODE_ENV=production in deploys (enables the production checks; MONGO_URL then needs auth + TLS).
# Web Push to staff phones: `bun run vapid:keys` prints a pair. Set all three or none (push stays off).
# VAPID_SUBJECT must be a mailto: or https: URL push services can reach you at.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Stripe Connect (pagos de citas, cargos directos a la cuenta de cada barbería).
# Sin estas dos variables, los endpoints de pago responden 503/503 y el resto sigue igual.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Publicable para el Payment Element del frontend (se devuelve en POST /v1/public/payments/intent).
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# URL pública del frontend (onboarding Connect: return/refresh de las Account Links).
# FRONTEND_URL=http://localhost:3000
# Comisión de plataforma en basis points (100 = 1%). 0 = sin comisión.
# STRIPE_APP_FEE_BPS=0
# Suscripción de las barberías a la app (Stripe Billing en la cuenta de la plataforma): un solo Price mensual
# (300 MXN), creado en Stripe. Sin él /v1/billing responde 503 BILLING_DISABLED. Pagar deja al tenant en plan pro.
# Webhooks: los mismos de /webhooks/stripe, agregando checkout.session.completed,
# checkout.session.async_payment_succeeded y customer.subscription.created/updated/deleted.
# STRIPE_SUBSCRIPTION_PRICE=price_...
# Local: `bun run stripe:listen` (en la raíz) reenvía los eventos; su whsec_ va en STRIPE_WEBHOOK_SECRET.
